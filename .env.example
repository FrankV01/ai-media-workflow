# Copy to .env and adjust as needed
APP_NAME="Frank Villasenor's AI Media Workflow Kit"
BUILD_NUMBER=dev
DEBUG=true
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# Automatic adjacent SQLite snapshots are retained by both age and count.
SQLITE_BACKUP_RETENTION_DAYS=90
SQLITE_BACKUP_RETENTION_COUNT=90

# LLM — defaults target LM Studio local server (OpenAI-compatible API)
#
# Env-only operational settings (never enter the database):
LLM_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=your-lm-studio-or-openai-key
LLM_TIMEOUT=3600
#
# Selector — the exact model key of the active (role, model) profile:
LLM_MODEL=qwen/qwen3.5-9b
#
# Seed-only values — used ONLY when a (role, model) profile row is missing;
# existing rows are never overwritten by env changes. Saved profiles live in
# llm_role_configurations — edit them at /settings/ai or /api/configurations.
# Profiles still on code defaults warn on every run until customized.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=32768
# Disables hidden reasoning on thinking models (Qwen3 etc.) so max_tokens isn't
# consumed by thinking; set true to allow it
LLM_ENABLE_THINKING=false

# Image generation — 'placeholder' for fast testing, 'comfyui' for real generation
#
# Default backend / model selectors — these seed new workflows and act as
# fallback when a workflow has no active media profile. The active profile is
# selected per workflow at /settings/ai?workflow=<slug> (stored on
# workflow.media_model_name); per-step overrides use
# {"block": "media_producer", "config": {"media_model": "..."}}.
GENERATION_BACKEND=placeholder
COMFYUI_CHECKPOINT=RealVisXL_V5.0_fp16.safetensors
#
# Seed-only values — used ONLY when the media profile row is missing; edit
# saved profiles at /settings/ai or /api/configurations:
COMFYUI_REFINER_CHECKPOINT=sd_xl_refiner_1.0.safetensors
COMFYUI_UPSCALE_2X_MODEL=RealESRGAN_x2.pth
COMFYUI_UPSCALE_4X_MODEL=RealESRGAN_x4.pth
REFINER_STEPS=20
REFINER_CFG_SCALE=6.0
REFINER_SAMPLER=dpmpp_2m
REFINER_SCHEDULER=karras
REFINER_DENOISE=0.25
#
# Env-only operational settings (never enter the database):
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_POLL_INTERVAL=2.0
COMFYUI_TIMEOUT=3600
IMAGE_OUTPUT_DIR=/Volumes/SanDisk Mac AI/ai-media-workflow/output

# FourthWall storefront (optional) — used by the `fourthwall_listing` block.
# Create the Open API user in the Fourthwall admin under "For developers";
# requests authenticate with HTTP Basic auth (username + password pair).
#FOURTHWALL_API_USER=
#FOURTHWALL_API_PASSWORD=
#FOURTHWALL_BASE_URL=https://api.fourthwall.com/open-api/v1.0
#FOURTHWALL_TIMEOUT=300

# Cloudflare R2 (optional) — used by the `cloudflare_r2_uploader` block to
# host the delivery ZIP buyers download. Create an R2 API token in the
# Cloudflare dashboard (R2 → Manage R2 API Tokens); endpoint, bucket, key
# prefix, and the public base URL are set under Settings → Store Fronts.
#CLOUDFLARE_R2_ACCESS_KEY_ID=
#CLOUDFLARE_R2_SECRET_ACCESS_KEY=
