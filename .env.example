# Copy to .env and adjust as needed
APP_NAME="AI Media Workflow"
DEBUG=true
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
MEDIA_DIR=./data/media

# LLM — defaults target LM Studio local server (OpenAI-compatible API)
LLM_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio
LLM_MODEL=google/gemma-4-12b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Image generation — 'placeholder' for fast testing, 'comfyui' for real generation
GENERATION_BACKEND=placeholder
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=RealVisXL_V5.0_fp16.safetensors
COMFYUI_POLL_INTERVAL=2.0
COMFYUI_TIMEOUT=600
IMAGE_OUTPUT_DIR=/Volumes/SanDisk Mac AI/ComfyUI/output
